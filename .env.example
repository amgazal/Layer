# Copy to ".env" for local dev. All values here are PUBLIC (safe in frontend) —
# Row Level Security is what protects the data. Never add the service_role key.
#
# Find the first two in Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Which sign-in buttons to show. Only list providers you have actually enabled
# in Supabase → Authentication → Providers, so testers never meet a dead button.
# Email links need no entry here; they work whenever cloud sync is configured.
#
#   google   → Sign in with Google (free to set up)
#   cornell  → "Continue with Cornell" (Google with a cornell.edu domain hint;
#              requires google to be listed too)
#   apple    → Sign in with Apple (requires a paid Apple Developer account)
#
# Leave blank for email-only sign-in.
VITE_AUTH_PROVIDERS=

# Optional deployment base override. Leave blank for automatic detection.
# Example: https://amgazal.github.io/Layer/
VITE_AUTH_REDIRECT_URL=
