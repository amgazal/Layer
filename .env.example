# Copy to ".env" for local dev. Both values are PUBLIC (safe in frontend) —
# Row Level Security is what protects the data. Never add the service_role key.
#
# Find these in Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
