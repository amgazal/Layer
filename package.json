{
  "name": "layer-weather",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "node --env-file=.env scripts/smoke-test.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:regressions": "node scripts/regression-check.mjs",
    "verify": "npm run check:regressions && npm run test && npm run build",
    "test:browser": "playwright test",
    "test:integration": "node scripts/local-integration.mjs",
    "test:auth": "node scripts/auth-browser.mjs",
    "test:production": "playwright test --config=playwright.production.config.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.2",
    "vitest": "^4.1.11"
  }
}
